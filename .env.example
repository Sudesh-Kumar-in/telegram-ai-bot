# Telegram BotFather se mila hua bot token
TELEGRAM_BOT_TOKEN=

# OpenAI platform se mili API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Kaunsa OpenAI model use karna hai (chahe to change kar sakte ho)
OPENAI_MODEL=gpt-4o-mini

# (Optional) SQLite database file ka path
DATABASE_PATH=bot_database.db

# (Optional) Har user ke liye kitne recent messages context mein bheje jayen
MAX_HISTORY_MESSAGES=10

# (Optional) OpenAI request timeout (seconds)
OPENAI_TIMEOUT=60
